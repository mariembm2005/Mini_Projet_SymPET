<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Admin{% endblock %} — SymPet</title>
    <link rel="stylesheet" href="{{ asset('bootstrap.min.css') }}">
    {% block stylesheets %}{% endblock %}
    <style>
        body { background: #f4f6fb; }

        .sidebar {
            min-height: 100vh;
            width: 240px;
            background: linear-gradient(180deg, #3b2f63, #6d4fc2);
            position: fixed;
            top: 0; left: 0;
            padding-top: 20px;
            z-index: 100;
        }

        .sidebar .brand {
            color: #fff;
            font-size: 1.3rem;
            font-weight: 800;
            padding: 10px 20px 25px;
            display: block;
            text-decoration: none;
        }

        .sidebar .nav-link {
            color: rgba(255,255,255,0.75);
            padding: 10px 20px;
            border-radius: 10px;
            margin: 2px 10px;
            font-size: 0.95rem;
            transition: 0.2s;
        }

        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            background: rgba(255,255,255,0.15);
            color: #fff;
        }

        .sidebar .nav-link .icon { margin-right: 8px; }

        .main-content {
            margin-left: 240px;
            padding: 30px;
        }

        .page-title {
            font-weight: 800;
            color: #3b2f63;
            margin-bottom: 25px;
        }

        .card-admin {
            border: none;
            border-radius: 16px;
            box-shadow: 0 4px 18px rgba(123, 104, 238, 0.1);
            background: #fff;
        }

        .btn-grad {
            background: linear-gradient(135deg, #ff6fae, #a78bfa);
            border: none;
            border-radius: 25px;
            color: #fff;
            padding: 8px 20px;
            transition: 0.3s;
        }

        .btn-grad:hover { opacity: 0.88; color: #fff; transform: scale(1.02); }

        .table th { color: #3b2f63; font-weight: 700; }

        .badge-statut-en_attente  { background: #fef3c7; color: #92400e; }
        .badge-statut-en_cours    { background: #dbeafe; color: #1e40af; }
        .badge-statut-completee   { background: #d1fae5; color: #065f46; }
    </style>
</head>
<body>

<!-- Sidebar -->
<div class="sidebar">
    <a class="brand" href="{{ path('app_admin_dashboard') }}">⚙️ SymPet Admin</a>

    <nav class="nav flex-column">
        <a class="nav-link {% if app.request.attributes.get('_route') == 'app_admin_dashboard' %}active{% endif %}"
           href="{{ path('app_admin_dashboard') }}">
            <span class="icon">📊</span> TNDshboard
        </a>
        <a class="nav-link {% if 'produit' in app.request.attributes.get('_route') %}active{% endif %}"
           href="{{ path('app_admin_produits') }}">
            <span class="icon">📦</span> Produits
        </a>
        <a class="nav-link {% if 'categorie' in app.request.attributes.get('_route') %}active{% endif %}"
           href="{{ path('app_admin_categories') }}">
            <span class="icon">🏷️</span> Catégories
        </a>
        <a class="nav-link {% if 'commande' in app.request.attributes.get('_route') %}active{% endif %}"
           href="{{ path('app_admin_commandes') }}">
            <span class="icon">🛒</span> Commandes
        </a>
        <a class="nav-link {% if 'utilisateur' in app.request.attributes.get('_route') %}active{% endif %}"
           href="{{ path('app_admin_utilisateurs') }}">
            <span class="icon">👥</span> Utilisateurs
        </a>

        <hr style="border-color: rgba(255,255,255,0.2); margin: 15px 10px;">

        <a class="nav-link" href="{{ path('app_home') }}">
            <span class="icon">🏠</span> Retour au site
        </a>
        <a class="nav-link text-danger-light" href="{{ path('app_logout') }}"
           style="color: rgba(255,150,150,0.85);">
            <span class="icon">🚪</span> Déconnexion
        </a>
    </nav>
</div>

<!-- Contenu principal -->
<div class="main-content">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type == 'success' ? 'success' : 'danger' }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" TNDta-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</div>

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
{% endblock %}
</body>
</html>
