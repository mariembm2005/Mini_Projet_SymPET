{% extends 'admin/base_admin.html.twig' %}

{% block title %}Catégories{% endblock %}

{% block body %}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="page-title mb-0">🏷️ Gestion des catégories</h2>
    <a href="{{ path('app_admin_categorie_nouvelle') }}" class="btn btn-grad">+ Nouvelle catégorie</a>
</div>

<div class="card-admin p-3">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>#</th>
                <th>Nom</th>
                <th>Description</th>
                <th>Nb produits</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for cat in categories %}
            <tr>
                <td>{{ cat.id }}</td>
                <td>{{ cat.nomCat }}</td>
                <td>{{ cat.description ?? '—' }}</td>
                <td>
                    <span class="badge bg-secondary">{{ cat.produits|length }}</span>
                </td>
                <td>
                    <a href="{{ path('app_admin_categorie_modifier', {id: cat.id}) }}"
                       class="btn btn-sm btn-outline-secondary me-1">✏️ Modifier</a>

                    <form method="POST"
                          action="{{ path('app_admin_categorie_supprimer', {id: cat.id}) }}"
                          style="display:inline;"
                          onsubmit="return confirm('Supprimer cette catégorie ?')">
                        <button class="btn btn-sm btn-outline-danger">🗑️ Supprimer</button>
                    </form>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="5" class="text-center text-muted py-4">Aucune catégorie trouvée.</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{% endblock %}
