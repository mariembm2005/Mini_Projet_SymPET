{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ produit ? 'Modifier' : 'Nouveau' }} produit{% endblock %}

{% block body %}

<div class="d-flex align-items-center mb-4">
    <a href="{{ path('app_admin_produits') }}" class="btn btn-sm btn-outline-secondary me-3">← Retour</a>
    <h2 class="page-title mb-0">
        {{ produit ? '✏️ Modifier le produit' : '➕ Nouveau produit' }}
    </h2>
</div>

<div class="card-admin p-4" style="max-width: 600px;">
    <form method="POST">

        <div class="mb-3">
            <label class="form-label fw-semibold">Nom du produit</label>
            <input type="text" name="nomProduit" class="form-control"
                   value="{{ produit ? produit.nomProduit : '' }}" required>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Description</label>
            <textarea name="description" class="form-control" rows="3">{{ produit ? produit.description : '' }}</textarea>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label fw-semibold">Prix (TND)</label>
                <input type="number" step="0.01" name="prix" class="form-control"
                       value="{{ produit ? produit.prix : '' }}" required>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label fw-semibold">Stock</label>
                <input type="number" name="stock" class="form-control"
                       value="{{ produit ? produit.stock : '' }}" required>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Catégorie</label>
            <select name="cat" class="form-select">
                <option value="">— Aucune —</option>
                {% for cat in categories %}
                    <option value="{{ cat.id }}"
                        {{ produit and produit.cat and produit.cat.id == cat.id ? 'selected' : '' }}>
                        {{ cat.nomCat }}
                    </option>
                {% endfor %}
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Image (URL ou nom de fichier)</label>
            <input type="text" name="image" class="form-control"
                   value="{{ produit ? produit.image : '' }}" placeholder="ex: produit.jpg">
        </div>

        <button type="submit" class="btn btn-grad">
            {{ produit ? 'Enregistrer les modifications' : 'Ajouter le produit' }}
        </button>

    </form>
</div>

{% endblock %}
