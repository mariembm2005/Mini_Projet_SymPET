{% extends 'admin/base_admin.html.twig' %}

{% block title %}Produits{% endblock %}

{% block body %}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="page-title mb-0">📦 Gestion des produits</h2>
    <a href="{{ path('app_admin_produit_nouveau') }}" class="btn btn-grad">+ Nouveau produit</a>
</div>

<div class="card-admin p-3">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>#</th>
                <th>Nom</th>
                <th>Catégorie</th>
                <th>Prix</th>
                <th>Stock</th>
                <th>Date ajout</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for produit in produits %}
            <tr>
                <td>{{ produit.id }}</td>
                <td>{{ produit.nomProduit }}</td>
                <td>{{ produit.cat ? produit.cat.nomCat : '—' }}</td>
                <td>{{ produit.prix|number_format(2, ',', ' ') }} TND</td>
                <td>
                    <span class="badge {{ produit.stock > 0 ? 'bg-success' : 'bg-danger' }}">
                        {{ produit.stock }}
                    </span>
                </td>
                <td>{{ produit.dateAjout ? produit.dateAjout|date('d/m/Y') : '—' }}</td>
                <td>
                    <a href="{{ path('app_admin_produit_modifier', {id: produit.id}) }}"
                       class="btn btn-sm btn-outline-secondary me-1">✏️ Modifier</a>

                    <form method="POST"
                          action="{{ path('app_admin_produit_supprimer', {id: produit.id}) }}"
                          style="display:inline;"
                          onsubmit="return confirm('Supprimer ce produit ?')">
                        <button class="btn btn-sm btn-outline-danger">🗑️ Supprimer</button>
                    </form>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="7" class="text-center text-muted py-4">Aucun produit trouvé.</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{% endblock %}
