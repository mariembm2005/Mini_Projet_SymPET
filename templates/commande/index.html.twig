{% extends 'base.html.twig' %}
{% block title %}Historique des commandes
{% endblock %}

{% block body %}
	<div class="container mt-5">
		<h4 class="mb-4">Historique des commandes</h4>

		{% for commande in commandes %}
			<div class="card mb-3">
				<div class="card-body d-flex justify-content-between align-items-center">
					<div>
						<strong>Commande #{{ commande.id }}</strong>
						<div class="text-muted small">{{ commande.dateCommande|date('d/m/Y') }}</div>
					</div>
					<div class="d-flex align-items-center gap-3">
						<span class="badge bg-warning text-dark">{{ commande.statut }}</span>
						<strong>{{ commande.montantTotal }}
							€</strong>
						<a href="{{ path('app_commande_detail', {id: commande.id}) }}" class="btn btn-outline-primary btn-sm">
							Voir détail
						</a>
					</div>
				</div>
			</div>
		{% else %}
			<div class="alert alert-warning">Aucune commande trouvée.</div>
		{% endfor %}

	</div>
{% endblock %}
