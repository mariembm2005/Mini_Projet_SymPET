{% extends 'base.html.twig' %}
{% block body %}

<style>
    body {
        background: #fafbff;
    }

    .auth-card {
        max-width: 420px;
        margin: 80px auto;
        padding: 35px;
        border-radius: 22px;
        background: #ffffff;
        box-shadow: 0 10px 30px rgba(255, 105, 180, 0.12);
    }

    .soft-title {
        font-weight: 800;
        color: #3b2f63;
        text-align: center;
    }

    .btn-primary-custom {
        background: linear-gradient(135deg, #ff6fae, #a78bfa);
        border: none;
        border-radius: 35px;
        padding: 12px;
        width: 100%;
        transition: 0.3s;
    }

    .btn-primary-custom:hover {
        opacity: 0.9;
        transform: scale(1.02);
    }

    .form-control {
        border-radius: 12px;
        padding: 10px;
    }

    p {
        color: #4b5563;
        text-align: center;
    }
</style>

<div class="auth-card">

    <h2 class="soft-title">Connexion</h2>
    <p>Accédez à votre espace SymPet 🐾</p>

    <form>

        <div class="mb-3">
            <label>Email</label>
            <input type="email" class="form-control" placeholder="exemple@email.com">
        </div>

        <div class="mb-3">
            <label>Mot de passe</label>
            <input type="password" class="form-control" placeholder="••••••••">
        </div>

        <button class="btn btn-primary-custom text-white">Se connecter</button>

    </form>

    <p class="mt-3">
        Pas de compte ? <a href="{{ path('app_signup') }}">Créer un compte</a>
    </p>

</div>

{% endblock %}