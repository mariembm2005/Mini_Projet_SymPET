{% extends 'base.html.twig' %}

{% block body %}

<style>
    body {
        background: #fafbff;
    }

    .auth-card {
        max-width: 460px;
        margin: 70px auto;
        padding: 35px;
        border-radius: 22px;
        background: #ffffff;
        box-shadow: 0 10px 30px rgba(123, 104, 238, 0.12);
    }

    .soft-title {
        font-weight: 800;
        color: #3b2f63;
        text-align: center;
    }

    .btn-primary-custom {
        background: linear-gradient(135deg, #ff6fae, #a78bfa);
        border: none;
        border-radius: 35px;
        padding: 12px;
        width: 100%;
        transition: 0.3s;
    }

    .btn-primary-custom:hover {
        opacity: 0.9;
        transform: scale(1.02);
    }

    .form-control {
        border-radius: 12px;
        padding: 10px;
    }

    p {
        color: #4b5563;
        text-align: center;
    }
</style>

<div class="auth-card">

    <h2 class="soft-title">Connexion</h2>

    {# ⚠️ erreurs Symfony Security #}
    {% if error %}
        <div class="alert alert-danger">
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
    {% endif %}

    <form method="post">

        {# ⚠️ IMPORTANT: _username #}
        <div class="mb-3">
            <label>Email</label>
            <input type="email" name="_username" class="form-control" required>
        </div>

        {# ⚠️ IMPORTANT: _password #}
        <div class="mb-3">
            <label>Mot de passe</label>
            <input type="password" name="_password" class="form-control" required>
        </div>

        {# ⚠️ CSRF protection obligatoire #}
        <input type="hidden" name="_csrf_token"
               value="{{ csrf_token('authenticate') }}">

        <button class="btn btn-primary-custom text-white">
            Se connecter
        </button>

    </form>

    <p class="mt-3">
        Pas de compte ? <a href="{{ path('app_signup') }}">S'inscrire</a>
    </p>
    <p class="mt-3 text-center">
    <a href="{{ path('app_reset_password') }}">
        Mot de passe oublié ?
    </a>
</p>

</div>

{% endblock %}