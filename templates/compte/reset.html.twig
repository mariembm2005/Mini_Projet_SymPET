{% extends 'base.html.twig' %}

{% block body %}

<style>
    body {
        background: #fafbff;
    }

    .auth-card {
        max-width: 460px;
        margin: 70px auto;
        padding: 35px;
        border-radius: 22px;
        background: #ffffff;
        box-shadow: 0 10px 30px rgba(123, 104, 238, 0.12);
    }

    .soft-title {
        font-weight: 800;
        color: #3b2f63;
        text-align: center;
    }

    .btn-primary-custom {
        background: linear-gradient(135deg, #ff6fae, #a78bfa);
        border: none;
        border-radius: 35px;
        padding: 12px;
        width: 100%;
        transition: 0.3s;
    }

    .btn-primary-custom:hover {
        opacity: 0.9;
        transform: scale(1.02);
    }

    .form-control {
        border-radius: 12px;
        padding: 10px;
    }

    p {
        color: #4b5563;
        text-align: center;
    }
</style>

<div class="auth-card">

    <h2 class="soft-title">Réinitialisation</h2>

    {% if error is defined and error %}
    <div class="alert alert-danger">{{ error }}</div>
{% endif %}

    {# STEP 1 - EMAIL #}
    {% if step == 1 %}

        <form method="post">
            <input type="hidden" name="step" value="1">

            <div class="mb-3">
                <label>Email</label>
                <input type="email" name="email" class="form-control" required>
            </div>

            <button class="btn btn-primary-custom text-white">
                Envoyer code
            </button>
        </form>

    {# STEP 2 - CODE #}
    {% elseif step == 2 %}

        <form method="post">
            <input type="hidden" name="step" value="2">

            <div class="mb-3">
                <label>Code de vérification</label>
                <input type="text" name="code" class="form-control" required>
            </div>

            <button class="btn btn-primary-custom text-white">
                Vérifier
            </button>
        </form>

    {# STEP 3 - NEW PASSWORD #}
    {% elseif step == 3 %}

        <form method="post">
            <input type="hidden" name="step" value="3">

            <div class="mb-3">
                <label>Nouveau mot de passe</label>
                <input type="password" name="password" class="form-control" required>
            </div>

            <button class="btn btn-primary-custom text-white">
                Modifier
            </button>
        </form>

    {% endif %}

    <p class="mt-3">
        <a href="{{ path('app_login') }}">Retour login</a>
    </p>

</div>

{% endblock %}