{% extends 'base.html.twig' %}
{% block body %}

<style>
    body {
        background: #fafbff;
    }

    .auth-card {
        max-width: 460px;
        margin: 70px auto;
        padding: 35px;
        border-radius: 22px;
        background: #ffffff;
        box-shadow: 0 10px 30px rgba(123, 104, 238, 0.12);
    }

    .soft-title {
        font-weight: 800;
        color: #3b2f63;
        text-align: center;
    }

    .btn-primary-custom {
        background: linear-gradient(135deg, #ff6fae, #a78bfa);
        border: none;
        border-radius: 35px;
        padding: 12px;
        width: 100%;
        transition: 0.3s;
    }

    .btn-primary-custom:hover {
        opacity: 0.9;
        transform: scale(1.02);
    }

    .form-control {
        border-radius: 12px;
        padding: 10px;
    }

    p {
        color: #4b5563;
        text-align: center;
    }
</style>

<div class="auth-card">

    <h2 class="soft-title">Créer un compte</h2>
    <p>Rejoignez SymPet 🐾</p>

    {# FORM SYMFONY (REMPLACE HTML STATIC UNIQUEMENT) #}
    {{ form_start(form) }}

        <div class="mb-3">
            <label>Nom complet</label>
            {{ form_widget(form.nom, {'attr': {'class': 'form-control', 'placeholder': 'Votre nom'}}) }}
        </div>

        <div class="mb-3">
            <label>Prénom</label>
            {{ form_widget(form.prenom, {'attr': {'class': 'form-control', 'placeholder': 'Votre prénom'}}) }}
        </div>

        <div class="mb-3">
            <label>Email</label>
            {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'exemple@email.com'}}) }}
        </div>

        <div class="mb-3">
            <label>Mot de passe</label>
            {{ form_widget(form.mdp, {'attr': {'class': 'form-control', 'placeholder': '••••••••'}}) }}
        </div>

        <div class="mb-3">
            <label>Adresse</label>
            {{ form_widget(form.adresse, {'attr': {'class': 'form-control'}}) }}
        </div>

        <div class="mb-3">
            <label>Téléphone</label>
            {{ form_widget(form.telephone, {'attr': {'class': 'form-control'}}) }}
        </div>

        <button class="btn btn-primary-custom text-white">
            S'inscrire
        </button>

    {{ form_end(form) }}

    <p class="mt-3">
        Déjà un compte ? <a href="{{ path('app_login') }}">Se connecter</a>
    </p>

</div>

{% endblock %}