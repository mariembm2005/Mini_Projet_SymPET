{% extends 'base.html.twig' %}

{% block body %}

<style>
    body { background: #fafbff; }
    .auth-card {
        max-width: 460px;
        margin: 70px auto;
        padding: 35px;
        border-radius: 22px;
        background: #ffffff;
        box-shadow: 0 10px 30px rgba(123, 104, 238, 0.12);
    }
    .soft-title { font-weight: 800; color: #3b2f63; text-align: center; }
    .btn-primary-custom {
        background: linear-gradient(135deg, #ff6fae, #a78bfa);
        border: none; border-radius: 35px; padding: 12px;
        width: 100%; transition: 0.3s;
    }
    .btn-primary-custom:hover { opacity: 0.9; transform: scale(1.02); }
    .form-control { border-radius: 12px; padding: 10px; }
    p { color: #4b5563; text-align: center; }
</style>

<div class="auth-card">

    <h2 class="soft-title">Vérification du code</h2>
    <p>Entrez le code envoyé à votre email</p>

    {% if error %}
        <div class="alert alert-danger">{{ error }}</div>
    {% endif %}

    <form method="POST">
        <div class="mb-3">
            <label>Code de vérification</label>
            <input type="text" name="code" class="form-control" placeholder="123456" required>
        </div>
        <button class="btn btn-primary-custom text-white">Vérifier</button>
    </form>

</div>

{% endblock %}
