{% extends 'base.html.twig' %}

{% block title %}Commande confirmée
{% endblock %}

{% block body %}

	<div style="text-align:center; padding: 50px;">

		<h1>✅ Paiement réussi !</h1>

		<p>Merci</p>
		<p>Merci
			<strong>{{ commande.user ? commande.user.email : '' }}</strong>
			pour votre commande.</p>
		pour votre commande.</p>

	<div style="border: 1px solid #ccc; padding: 20px; display:inline-block; margin: 20px;">
