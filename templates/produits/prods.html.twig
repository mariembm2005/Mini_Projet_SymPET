{% extends 'base.html.twig' %}

{% block title %}Hello ProduitsController!
{% endblock %}

{% block body %}
	{% for message in app.flashes('success') %}
		<div class="alert alert-success">
			{{ message }}
		</div>
	{% endfor %}
	<table class="table">
		<thead>
			<th>Image</th>
			<th>Nom</th>
			<th>Prix</th>
			<th colspan="2">Action</th>

		</thead>
		<tbody>
			<tr>
				{% for produit in produits %}
					<td>
						<img src="{{produit.image}}" alt="">

					</td>
					<td>
						{{produit.NomProduit}}
					</td>
					<td>
						{{produit.Prix}}
					</td>
					<td>
						<a class="btn btn-primary" href="{{ url('app_produit_detail', {'id': produit.id}) }}">
							Voir
						</a>
					</td>
					<td>
						<a href="{{ url('cart_add', {'id': produit.id}) }}" class="btn btn-success">
							Ajouter au panier
						</a>
					</td>
				</tr>
			{% endfor %}

		</tbody>
	</table>


{% endblock %}
