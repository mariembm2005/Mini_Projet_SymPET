{% extends 'base.html.twig' %}

{% block title %}Produits
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<style>
		.product-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
			gap: 1.5rem;
		}

		.product-card {
			background: white;
			border: 1px solid var(--border);
			border-radius: 16px;
			overflow: hidden;
			transition: transform 0.3s ease, box-shadow 0.3s ease;
			opacity: 0;
			transform: translateY(24px);
			animation: fadeUp 0.5s ease forwards;
		}

		.product-card:nth-child(1) {
			animation-delay: 0.05s;
		}
		.product-card:nth-child(2) {
			animation-delay: 0.10s;
		}
		.product-card:nth-child(3) {
			animation-delay: 0.15s;
		}
		.product-card:nth-child(4) {
			animation-delay: 0.20s;
		}
		.product-card:nth-child(5) {
			animation-delay: 0.25s;
		}
		.product-card:nth-child(6) {
			animation-delay: 0.30s;
		}

		@keyframes fadeUp {
			to {
				opacity: 1;
				transform: translateY(0);
			}
		}

		.product-card:hover {
			transform: translateY(-6px);
			box-shadow: 0 16px 40px rgba(0, 0, 0, 0.08);
		}

		.product-img-wrap {
			overflow: hidden;
			height: 200px;
			background: var(--sage-light);
			display: flex;
			align-items: center;
			justify-content: center;
		}

		.product-img-wrap img {
			width: 100%;
			height: 100%;
			object-fit: contain;
			transition: transform 0.4s ease;
			padding: 1rem;
		}

		.product-card:hover .product-img-wrap img {
			transform: scale(1.06);
		}

		.product-body {
			padding: 1.25rem;
		}

		.product-name {
			font-family: 'Playfair Display', serif;
			font-size: 1rem;
			font-weight: 600;
			margin-bottom: 4px;
			color: var(--charcoal);
		}

		.product-desc {
			font-size: 13px;
			color: var(--muted);
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			overflow: hidden;
			margin-bottom: 10px;
		}

		.product-price {
			font-size: 1.1rem;
			font-weight: 600;
			color: var(--sage);
		}

		.product-footer {
			padding: 1rem 1.25rem;
			border-top: 1px solid var(--border);
			display: flex;
			gap: 8px;
		}

		.btn-see {
			flex: 1;
			padding: 8px;
			border: 1px solid var(--border);
			border-radius: 100px;
			background: white;
			font-size: 13px;
			text-align: center;
			text-decoration: none;
			color: var(--charcoal);
			transition: all 0.2s;
		}

		.btn-see:hover {
			background: var(--charcoal);
			color: white;
			border-color: var(--charcoal);
		}

		.btn-add {
			flex: 1;
			padding: 8px;
			border: none;
			border-radius: 100px;
			background: var(--sage);
			color: white;
			font-size: 13px;
			text-align: center;
			text-decoration: none;
			transition: background 0.2s;
		}

		.btn-add:hover {
			background: #5f8564;
			color: white;
		}

		.btn-disabled {
			flex: 1;
			padding: 8px;
			border-radius: 100px;
			background: var(--sage-light);
			color: var(--muted);
			font-size: 13px;
			text-align: center;
			border: none;
			cursor: not-allowed;
		}

		.page-heading {
			display: flex;
			align-items: baseline;
			gap: 12px;
			margin-bottom: 2rem;
		}

		.page-heading h2 {
			font-size: 1.8rem;
			margin: 0;
		}

		.page-heading span {
			font-size: 13px;
			color: var(--muted);
		}

		.pagination {
			justify-content: center;
			margin-top: 2.5rem;
		}
		.page-link {
			border-radius: 100px !important;
			margin: 0 3px;
			border-color: var(--border);
			color: var(--charcoal);
		}
		.page-item.active .page-link {
			background: var(--charcoal);
			border-color: var(--charcoal);
		}
	</style>
{% endblock %}

{% block body %}

	<div class="page-heading">
		<h2>
			{% if search %}Résultats pour "{{ search }}"{% else %}Nos Produits
			{% endif %}
		</h2>
		<span>{{ produits|length }}
			article(s)</span>
	</div>

	<div class="product-grid">
		{% for produit in produits %}
			<div class="product-card">

				<div class="product-img-wrap">
					<img src="{{ produit.image }}" alt="{{ produit.NomProduit }}">
				</div>

				<div class="product-body">
					<p class="product-name">{{ produit.NomProduit }}</p>
					<p class="product-desc">{{ produit.Description }}</p>
					<p class="product-price">{{ produit.Prix }}
						DT</p>
				</div>

				<div class="product-footer">
					<a href="{{ url('app_produit_detail', {'id': produit.id}) }}" class="btn-see">
						<i class="fas fa-eye me-1"></i>
						Voir
					</a>
					{% if produit.dispo %}
						<a href="{{ url('cart_add', {'id': produit.id}) }}" class="btn-add">
							<i class="fas fa-basket-shopping me-1"></i>
							Ajouter
						</a>
					{% else %}
						<button class="btn-disabled" disabled>Indisponible</button>
					{% endif %}
				</div>

			</div>
		{% else %}
			<p style="color:var(--muted);">Aucun produit trouvé.</p>
		{% endfor %}
	</div>

	<div class="navigation">
		{{ knp_pagination_render(produits) }}
	</div>

{% endblock %}
