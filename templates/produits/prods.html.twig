{% extends 'base.html.twig' %}

{% block title %}Produits
{% endblock %}
{% block stylesheets %}
	{{parent()}}
	<style>
		/* ===== PAGE ANIMATION ===== */
		.row .col-md-4 {
			opacity: 0;
			transform: translateY(30px);
			animation: fadeUp 0.6s ease forwards;
		}

		/* delay for each card (stagger effect) */
		.row .col-md-4:nth-child(1) {
			animation-delay: 0.1s;
		}
		.row .col-md-4:nth-child(2) {
			animation-delay: 0.2s;
		}
		.row .col-md-4:nth-child(3) {
			animation-delay: 0.3s;
		}
		.row .col-md-4:nth-child(4) {
			animation-delay: 0.4s;
		}
		.row .col-md-4:nth-child(5) {
			animation-delay: 0.5s;
		}
		.row .col-md-4:nth-child(6) {
			animation-delay: 0.6s;
		}

		@keyframes fadeUp {
			to {
				opacity: 1;
				transform: translateY(0);
			}
		}

		.card {
			border-radius: 12px;
			overflow: hidden;
			transition: all 0.3s ease;
		}


		.card:hover {
			transform: translateY(-10px);
			box-shadow: 0 12px 25px rgba(0, 0, 0, 0.15);
		}


		.card img {
			transition: transform 0.4s ease;
		}

		.card:hover img {
			transform: scale(1.08);
		}


		.btn {
			transition: all 0.3s ease;
		}

		.btn:hover {
			transform: scale(1.05);
		}
		.text-truncate {
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}
	</style>
{% endblock %}

{% block body %}

	{% for message in app.flashes('success') %}
		<div class="alert alert-success">
			{{ message }}
		</div>
	{% endfor %}

	{% if search %}
		<h2 class="mb-4">Nos Produits de
			{{search}}
		</h2>
	{% else %}
		<h2 class="mb-4">Nos Produits</h2>
	{% endif %}
	<div class="row">
		{% for produit in produits %}
			<div class="col-md-4 mb-4">
				<div class="card h-100 shadow-sm">
					<img src="{{ produit.image }}" class="card-img-top d-flex justify-content-center align-items-center vh-100" style="width:100%; height:200px; object-fit:contain;" alt="">
					<div class="card-body">
						<h5 class="card-title">{{ produit.NomProduit }}</h5>
						<p class="card-text text-success fw-bold">
							{{ produit.Prix }}
							DT
						</p>
						<p class="text-truncate">
							{{produit.Description}}
						</p>
					</div>
					<div class="card-footer text-center">
						<a class="btn btn-primary btn-sm" href="{{ url('app_produit_detail', {'id': produit.id}) }}">
							Voir
						</a>
						{% if produit.dispo %}
							<a href="{{ url('cart_add', {'id': produit.id}) }}" class="btn btn-success btn-sm">
								Ajouter au panier
							</a>
						{% else %}
							<button class="btn btn-secondary btn-sm" disabled>
								Indisponible
							</button>
						{% endif %}
					</div>
				</div>
			</div>
		{% endfor %}

	</div>
	<div class="navigation">
		{{ knp_pagination_render(produits) }}

	</div>

{% endblock %}
